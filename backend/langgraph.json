{
  "dependencies": ["."],
  "graphs": {
    "agent": "./src/agent/graph.py:graph"
  },
  "http": {
    "app": "./src/agent/app.py:app"
  },
  "auth": {
    "path": "./src/agent/langgraph_auth.py:auth",
    "openapi": {
      "securitySchemes": {
        "bearerAuth": {
          "type": "http",
          "scheme": "bearer",
          "bearerFormat": "JWT"
        }
      },
      "security": [{ "bearerAuth": [] }]
    },
    "disable_studio_auth": false
  },
  "env": ".env"
}
